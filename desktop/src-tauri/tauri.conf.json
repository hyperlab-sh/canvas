{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas",
  "identifier": "sh.hyperlab.canvas",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Native window for the Canvas diagram editor"
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["canvas"] } }
  }
}
